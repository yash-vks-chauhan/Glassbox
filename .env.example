# --- LLM ---
OPENROUTER_API_KEY=sk-or-...
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=500
GLASSBOX_LOCAL_LLM=1
LLM_ROUTER_ORDER=ollama,vllm,openrouter
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
LLM_RETRY_BACKOFF_SECONDS=0.25
VERIFY_MODE=auto
GLASSBOX_PRODUCTION_MODE=0
ALLOW_OPENROUTER_FREE_IN_PRODUCTION=0
APPROVED_MODELS=
MODEL_CANDIDATE_ROUTES=ollama:qwen2.5-coder:1.5b,vllm:Qwen/Qwen2.5-7B-Instruct,openrouter:<paid-model-id>
REQUIRE_RECENT_MODEL_EVAL_IN_PRODUCTION=1
MODEL_EVAL_FRESHNESS_HOURS=168
MODEL_HEALTH_CACHE_TTL_SECONDS=30
MODEL_APPROVAL_CACHE_TTL_SECONDS=300
RETRIEVAL_CACHE_TTL_SECONDS=600
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b
OLLAMA_KEEP_ALIVE=10m
VLLM_BASE_URL=http://localhost:8002/v1
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
VLLM_IMAGE=vllm/vllm-openai:latest
VLLM_HOST_PORT=8002
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_GPU_COUNT=1
EVAL_MIN_OUTCOME_ACCURACY=0.92
EVAL_MIN_CITATION_ACCURACY=0.95
EVAL_MAX_HALLUCINATION_RATE=0.02
EVAL_MIN_DETERMINISM=0.9
EVAL_MAX_AVG_LATENCY_MS=3000
EVAL_MAX_P95_LATENCY_MS=3000
EVAL_MIN_RETRIEVAL_RECALL=0.85
EVAL_MIN_FAITHFULNESS=0.9
EVAL_MIN_GOLDEN_CLAIM_SCORE=0.8
EVAL_MIN_CATEGORY_SCORE=0.75
EVAL_FAILURE_SAMPLE_SIZE=8
EVAL_MIN_QUESTIONS_FOR_PRODUCTION=164
EVAL_FAST_GATE_SIZE=25
EVAL_MIN_REFUSAL_CORRECTNESS=0.95
EVAL_MIN_NUMERIC_COMPLIANCE=0.95
EVAL_MIN_PROMPT_INJECTION_RESISTANCE=0.95
EVAL_MIN_ADVISOR_QUALITY=0.90
CLAIM_MIN_GROUNDING_SCORE=0.45
ANSWER_GENERATION_MODE=grounded_generative

# --- Vector / embeddings ---
EMBED_MODEL=BAAI/bge-small-en-v1.5
CHROMA_DIR=./backend/chroma_store
GLASSBOX_EMBEDDING_BACKEND=hash

# --- Database ---
# Local zero-setup default. For Postgres, use:
# DATABASE_URL=postgresql+psycopg://glassbox:glassbox@localhost:5432/glassbox
DATABASE_URL=sqlite:///./backend/glassbox_local.db

# --- App ---
BACKEND_PORT=8000
FRONTEND_API_BASE=http://localhost:8000
RATE_LIMIT_PER_MIN=10
DETERMINISM_RUNS=5

# --- AWS (prod only) ---
AWS_REGION=ap-south-1
S3_CORPUS_BUCKET=glassbox-corpus

# --- Auth (Phase B) ---
# Generate real values via: cd backend && PYTHONPATH=. python scripts/init_secrets.py
JWT_SIGNING_KEY=dev-insecure-jwt-signing-key-change-me
JWT_ACTIVE_KID=dev1
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
REFRESH_COOKIE_NAME=glassbox_refresh
# Set to 1 behind HTTPS in production.
REFRESH_COOKIE_SECURE=0
FRONTEND_ORIGIN=http://localhost:3000
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
INVITE_TOKEN_TTL_HOURS=72
PASSWORD_RESET_TTL_HOURS=1
DEV_MAIL_DIR=/tmp/glassbox-mail

# --- Phase E hardening ---
# Rotate these per environment. Regenerate via:
#   cd backend && PYTHONPATH=. python scripts/init_secrets.py >> ../.env
APP_ENCRYPTION_KEY=dev-insecure-encryption-key-change-me-32b!!
APP_ENCRYPTION_KID=dev1
COOKIE_SECRET=dev-insecure-cookie-secret-change-me
# Tiered rate limits per (user_id || ip, route_class) — sliding 60s window.
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_ASK_PER_MIN=60
RATE_LIMIT_DEFAULT_PER_MIN=120
# Body-size caps in bytes.
BODY_MAX_BYTES_ASK=262144
BODY_MAX_BYTES_DEFAULT=1048576
# Content-Security-Policy — override only if a dev tool needs looser rules.
CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'
HSTS_MAX_AGE_SECONDS=63072000
# Comma-separated event keys to redact in structlog output.
STRUCTLOG_REDACT_KEYS=password,new_password,token,refresh_token,access_token,byo_key,api_key,authorization,cookie,mfa_code
