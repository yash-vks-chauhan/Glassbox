# --- LLM ---
OPENROUTER_API_KEY=sk-or-...
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_TEMPERATURE=0.1
GLASSBOX_LOCAL_LLM=1

# --- Vector / embeddings ---
EMBED_MODEL=BAAI/bge-small-en-v1.5
CHROMA_DIR=./backend/chroma_store
GLASSBOX_EMBEDDING_BACKEND=hash

# --- Database ---
# Local zero-setup default. For Postgres, use:
# DATABASE_URL=postgresql+psycopg://glassbox:glassbox@localhost:5432/glassbox
DATABASE_URL=sqlite:///./backend/glassbox_local.db

# --- App ---
BACKEND_PORT=8000
FRONTEND_API_BASE=http://localhost:8000
RATE_LIMIT_PER_MIN=10
DETERMINISM_RUNS=5

# --- AWS (prod only) ---
AWS_REGION=ap-south-1
S3_CORPUS_BUCKET=glassbox-corpus
